# --- LLM Provider (Groq, OpenAI-compatible) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Vision-capable model, used only to read payment screenshots (Stage 2).
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Business (call-to-order routing) ---
ORDER_PHONE_NUMBER=7015943285
CUSTOM_CAKE_PHONE_NUMBER=7015943285
BULK_ORDER_PHONE_NUMBER=7777777777

# --- Email (Gmail SMTP) — feedback is emailed, not stored in a database ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
# Use a Gmail App Password (not your normal password): https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-gmail-app-password
FEEDBACK_EMAIL_TO=gsiddhant947@gmail.com

# --- Corporate SSL interception (LOCAL DEV ONLY, see CLAUDE.md) ---
# Path to your company's root CA bundle, if available.
REQUESTS_CA_BUNDLE=
# Only set to true on a locked-down local dev machine when the CA bundle
# above is unavailable. Never set this in staging/production.
DEV_DISABLE_SSL_VERIFY=false
